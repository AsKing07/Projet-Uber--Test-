{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "commonjs",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node"],
		"baseUrl": "./",
		"paths": {
			"@/*": ["src/*"],
			"@test/*": ["test/*"]
		}
	},
	"include": ["src", "test", "setup-integration-tests", "*.config.ts"],
	"exclude": ["node_modules"]
}
